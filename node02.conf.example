# EXAMPLE ONLY. Do not use these values.
# Generate real keys with: ./asft -g
# NETWORK_KEY must be identical on the gateway and every node.
# NODE02_KEY must match the "node node02" line in the gateway config.
# Copy to a file without .example before use.
#
# Sample configuration for node02
#

debug 1
mode node
# Must match the gateway. Generate with: ./asft -g
network_id NETWORK_KEY
port /dev/ttyUSB2 1200
gateway gw NODE02_KEY
